# issue-pilot configuration
# Copy to issue-pilot.conf next to this file (or point ISSUE_PILOT_CONF at it) and edit.
# Every value is sourced as shell — quote anything with spaces.

# --- Repo / queue ---
GH_REPO="owner/repo"                 # the repo whose issues are the work queue
READY_LABEL="status/approved"        # issues with this label are eligible for workers
CLAIM_LABEL="in-pilot"               # dispatcher adds this when a worker picks an issue up

# --- Refill (issue generation) ---
REFILL_THRESHOLD=10                  # run the scanner when open ready issues drop below this
# Command that generates new issues (your scanner pipeline). Runs from ISSUE_PILOT_HOME.
SCANNER_CMD="echo 'no scanner configured' >&2; exit 1"
# Example:
# SCANNER_CMD="claude -p 'Read the scanners/ directory and file up to 75 high-quality issues …'"

# --- Dispatch (batch sessions) ---
POLL_SECS=30                         # how often the dispatcher re-checks for ready issues
BASE_BRANCH="main"                   # branch subagents branch from and open PRs against
ISSUE_ORDER="oldest"                 # "oldest" or "newest" issues first
AUTO_MERGE=false                     # true = merge green-CI PRs; false = leave for review
BATCH_SIZE=25                        # issues per batch session (small batches survive session limits)
#REPO_DIR="/path/to/shared-clone"    # shared base clone; subagents branch worktrees off it (default: <issue-pilot>/repo)
CONCURRENCY=3                        # subagents in parallel inside a batch session
MIN_CONCURRENCY=1                    # pacer bounds
MAX_CONCURRENCY=6
# One batch session; orchestrates its own subagents. Gets BATCH_SIZE, CONCURRENCY,
# GH_REPO, BASE_BRANCH, AUTO_MERGE, ISSUE_ORDER, READY_LABEL, CLAIM_LABEL in its env.
BATCH_CMD="echo 'no batch command configured' >&2; exit 1"
# Examples:
# BATCH_CMD='claude -p "$(envsubst < examples/goal.md)" --dangerously-skip-permissions'
# BATCH_CMD='codex exec "$(envsubst < examples/goal.md)"'
# Multiple Claude subscriptions? Identity lives in the config DIRECTORY, not in a
# settings file — give each account its own dir (log in once per dir) and pick it
# per command with CLAUDE_CONFIG_DIR:
# BATCH_CMD='CLAUDE_CONFIG_DIR=$HOME/.claude-work claude -p "$(envsubst < examples/goal.md)" --dangerously-skip-permissions'

# --- Pace (quota thermostat) ---
# Command printing two numbers on one line: "<pct_of_quota_used 0-100> <seconds_until_reset>".
# Leave empty to disable pacing (batches then run at constant CONCURRENCY).
# bin/usage-claude.sh reads the official numbers Claude Code's /usage screen shows:
# USAGE_CMD="bash bin/usage-claude.sh"
USAGE_CMD=""
#CLAUDE_CREDENTIALS="$HOME/.claude/.credentials.json"  # credentials of the account batches burn

# --- Status page (bin/status.sh + issue-pilot-web.service) ---
# Accounts shown on the page: semicolon-separated "name|kind|path" entries.
#   kind=claude → path is that account's .credentials.json (config dir = its dirname)
#   kind=codex  → path is the ~/.codex/sessions directory
#STATUS_ACCOUNTS="Claude main|claude|$HOME/.claude/.credentials.json;Codex|codex|$HOME/.codex/sessions"
PACE_TOLERANCE=10                    # % deviation from ideal burn line before scaling up/down
# Optional: notified when actual usage drifts >2x tolerance from the ideal line. Gets $MSG.
NOTIFY_CMD=""
# Example: NOTIFY_CMD='curl -s -d "$MSG" ntfy.sh/my-topic'
