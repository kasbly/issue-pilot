[Unit]
Description=issue-pilot: promote base -> staging -> production when enough commits wait
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=ISSUE_PILOT_HOME=/opt/issue-pilot
ExecStart=/usr/bin/env bash /opt/issue-pilot/bin/promote.sh
# promotions babysit CI for a long time
TimeoutStartSec=12h
