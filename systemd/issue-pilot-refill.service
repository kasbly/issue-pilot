[Unit]
Description=issue-pilot: refill the issue queue when it runs low
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# backstop for a scan that ignores the in-script cap: kill the whole cgroup
TimeoutStartSec=2h
Environment=ISSUE_PILOT_HOME=/opt/issue-pilot
ExecStart=/usr/bin/env bash /opt/issue-pilot/bin/refill.sh
