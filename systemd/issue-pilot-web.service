[Unit]
Description=issue-pilot: status page web server
After=network-online.target

[Service]
# Bind to a private interface (VPN/Tailscale IP) — the page exposes usage data.
ExecStart=/usr/bin/python3 -m http.server 9124 --bind 127.0.0.1 --directory /opt/issue-pilot/web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
