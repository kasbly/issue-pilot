[Unit]
Description=issue-pilot: status page + control API
After=network-online.target

[Service]
# panel-launched runs (Promote now, Run now) must survive a webserver restart
KillMode=process
# Bind to a private interface (VPN/Tailscale IP) — the page exposes usage data and
# the API changes configuration.
Environment=ISSUE_PILOT_HOME=/opt/issue-pilot
ExecStart=/usr/bin/python3 /opt/issue-pilot/bin/webserver.py 127.0.0.1 9124
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
